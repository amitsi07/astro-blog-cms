---
interface Props {
  totalCount: number;
}

const { totalCount = 8 } = Astro.props;
---

<section class="relative overflow-hidden pt-16 pb-12 border-b border-[#1b1e2a] bg-gradient-to-b from-[#10121a] via-[#0c0d12] to-[#0c0d12] text-center">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="inline-flex items-center gap-2 text-xs font-semibold text-violet-400 mb-3 tracking-wide px-3 py-1 rounded-full bg-violet-950/50 border border-violet-800/40">
      <span>✦</span>
      <span>Astro 5 Content Collections & Cloudflare Edge</span>
    </div>

    <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white tracking-tight mb-4">
      PromptPlum AI Directory
    </h1>
    
    <p class="text-sm sm:text-base text-slate-400 max-w-2xl mx-auto mb-8 leading-relaxed">
      Curated directory of production-tested AI image prompts, photographic camera settings, and lighting formulas.
    </p>

    <!-- Instant Live Search Bar -->
    <div class="max-w-2xl mx-auto relative mb-6">
      <input
        id="promptSearchInput"
        type="text"
        placeholder="Search prompts, cameras (e.g. 85mm, Hasselblad), lighting, styles..."
        class="w-full bg-[#151722] border border-[#2b2f42] rounded-xl px-5 py-3.5 text-sm sm:text-base text-white placeholder-slate-500 focus:outline-none focus:border-violet-500 shadow-xl transition-all"
      />
    </div>

    <!-- AI Model Filter Pills -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 max-w-3xl mx-auto mb-4" id="modelFiltersContainer">
      <button data-model="All" class="model-filter-btn px-3 py-1.5 text-xs font-medium rounded-lg bg-violet-600 text-white transition-all cursor-pointer">All Engines</button>
      <button data-model="Midjourney v6" class="model-filter-btn px-3 py-1.5 text-xs font-medium rounded-lg bg-[#151722] text-slate-400 hover:text-white border border-[#232738] transition-all cursor-pointer">Midjourney v6</button>
      <button data-model="Flux.1" class="model-filter-btn px-3 py-1.5 text-xs font-medium rounded-lg bg-[#151722] text-slate-400 hover:text-white border border-[#232738] transition-all cursor-pointer">Flux.1</button>
      <button data-model="Gemini / Imagen 3" class="model-filter-btn px-3 py-1.5 text-xs font-medium rounded-lg bg-[#151722] text-slate-400 hover:text-white border border-[#232738] transition-all cursor-pointer">Gemini / Imagen</button>
      <button data-model="ChatGPT / DALL·E 3" class="model-filter-btn px-3 py-1.5 text-xs font-medium rounded-lg bg-[#151722] text-slate-400 hover:text-white border border-[#232738] transition-all cursor-pointer">ChatGPT / DALL-E</button>
    </div>

    <!-- Proof stats -->
    <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400 font-mono pt-4 border-t border-[#181a24]">
      <span class="text-white font-semibold">{totalCount} Tested Prompts</span>
      <span>·</span>
      <span>Pure Astro 5 SSG</span>
      <span>·</span>
      <span class="text-emerald-400 font-semibold">100% Free Cloudflare Pages CDN</span>
    </div>
  </div>
</section>
