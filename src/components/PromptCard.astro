---
interface Props {
  title: string;
  slug: string;
  prompt?: string;
  excerpt?: string;
  image: string;
  model?: string;
  category?: string;
  aspectRatio?: string;
}

const {
  title,
  slug,
  prompt = '',
  excerpt = '',
  image,
  model = 'Midjourney v6',
  category = 'Portraits',
  aspectRatio = '3:4',
} = Astro.props;
---

<div
  class="prompt-card group bg-[#131520] border border-[#23273a] hover:border-violet-500/60 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col justify-between shadow-xl"
  data-title={title.toLowerCase()}
  data-prompt={prompt.toLowerCase()}
  data-category={category}
  data-model={model}
>
  <a href={`/posts/${slug}`} class="block relative aspect-[3/4] overflow-hidden bg-black/40">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#131520] via-transparent to-transparent opacity-80"></div>
    <div class="absolute top-3 left-3 px-2 py-0.5 rounded bg-black/70 backdrop-blur-md text-[11px] font-mono text-violet-300 border border-white/10 shadow-sm">
      {model}
    </div>
    <div class="absolute bottom-3 left-3 right-3 text-xs text-slate-300 font-mono flex items-center justify-between">
      <span class="bg-black/60 px-2 py-0.5 rounded text-[11px] border border-white/5">{category}</span>
      <span class="bg-black/60 px-2 py-0.5 rounded text-[11px] border border-white/5">{aspectRatio}</span>
    </div>
  </a>

  <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
    <a href={`/posts/${slug}`}>
      <h3 class="text-sm font-bold text-white group-hover:text-violet-300 transition-colors line-clamp-2">
        {title}
      </h3>
      {excerpt && (
        <p class="text-xs text-slate-400 line-clamp-2 mt-1 leading-relaxed">
          {excerpt}
        </p>
      )}
    </a>

    <div class="pt-2 border-t border-[#1f222e] flex items-center gap-2">
      <button
        type="button"
        class="copy-prompt-btn flex-1 py-1.5 px-3 rounded-lg text-xs font-semibold bg-[#1a1c2a] hover:bg-violet-600 text-slate-200 hover:text-white border border-[#2d3148] transition-colors cursor-pointer text-center select-none"
        data-prompt={prompt}
      >
        Copy Prompt
      </button>
      <a
        href={`/posts/${slug}`}
        class="p-1.5 rounded-lg bg-[#1a1c2a] hover:bg-[#25283d] text-violet-300 transition-colors flex items-center justify-center"
        title="View Full Post"
      >
        &rarr;
      </a>
    </div>
  </div>
</div>
