---
interface Props {
  categories: string[];
}

const { categories = ['Portraits', 'Cinematic', 'Realistic', 'Fashion & Editorial', 'Cyberpunk & Sci-Fi', 'Fantasy & Surreal', 'Tutorials & Guides'] } = Astro.props;
---

<div class="border-b border-[#1c1f2c] bg-[#0c0d12]/90 backdrop-blur-sm sticky top-16 z-30 py-3">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 overflow-x-auto no-scrollbar" id="categoryFiltersContainer">
    <button
      data-category="all"
      class="cat-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap bg-violet-600 text-white cursor-pointer transition-colors shadow-sm"
    >
      All Categories
    </button>
    {categories.map((cat) => (
      <button
        data-category={cat}
        class="cat-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap bg-[#131520] text-slate-400 hover:text-white border border-[#212435] cursor-pointer transition-colors"
      >
        {cat}
      </button>
    ))}
  </div>
</div>
