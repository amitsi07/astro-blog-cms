---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => data.status === 'published');
const articles = allPosts.filter(p => p.data.type === 'article');
---

<Layout title="Articles & Photography Masterclasses – PromptPlum AI">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10 pb-4 border-b border-[#1f222e]">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-violet-400 mb-2 font-mono">
        <span>✦</span>
        <span>Astro Static Guides</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-white">Articles & Lighting Masterclasses</h1>
      <p class="text-slate-400 text-sm mt-2 max-w-xl">Deep dives into lighting color temperatures, camera optical setups, and prompt engineering formulations.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {articles.map((item) => (
        <a href={`/posts/${item.data.slug}`} class="group bg-[#131520] border border-[#23273a] hover:border-violet-500 rounded-2xl overflow-hidden p-6 transition-all space-y-4 flex flex-col justify-between shadow-xl">
          <div>
            <div class="flex items-center gap-2 text-xs text-violet-400 font-mono mb-2">
              <span class="bg-violet-950/60 px-2.5 py-0.5 rounded border border-violet-800/40">{item.data.category}</span>
              <span>·</span>
              <span class="text-slate-400">{item.data.publishedAt || item.data.createdAt}</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-violet-300 transition-colors">
              {item.data.title}
            </h2>
            <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mt-2 leading-relaxed">
              {item.data.excerpt}
            </p>
          </div>
          <div class="pt-4 border-t border-[#1f222e] flex items-center justify-between">
            <span class="text-xs font-mono text-slate-400">By {item.data.author}</span>
            <span class="text-xs font-semibold text-violet-400 group-hover:translate-x-1 transition-transform flex items-center gap-1">
              Read Guide &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
