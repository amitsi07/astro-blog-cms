---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const publishedPosts = await getCollection('posts', ({ data }) => data.status === 'published');
const prompts = publishedPosts.filter(p => p.data.type === 'prompt');
const featuredPrompts = prompts.filter(p => p.data.featured).slice(0, 3);
---

<Layout title="PromptPlum AI – Astro-Powered AI Photo Prompts & Photography Masterclasses">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 pb-12 border-b border-[#1b1e2a] bg-gradient-to-b from-[#10121a] to-[#0c0d12] text-center">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-violet-400 mb-3">
        <span>✦</span>
        <span>Curated AI Photo Editing & Generative Prompts · Tested & Verified</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white tracking-tight mb-4">
        PromptPlum AI Prompts Library
      </h1>
      <p class="text-sm sm:text-base text-slate-400 max-w-2xl mx-auto mb-8 leading-relaxed">
        Discover, customize, and copy tested AI photography prompts for Midjourney, Gemini, ChatGPT, and Flux. 100% free Cloudflare Pages + Astro SSG deployment.
      </p>

      <!-- Proof stats -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400 font-mono">
        <span class="text-white font-semibold">{prompts.length} Verified Prompts</span>
        <span>·</span>
        <span>Astro Content Collections</span>
        <span>·</span>
        <span class="text-emerald-400">Cloudflare Edge SSG</span>
      </div>
    </div>
  </section>

  <!-- Prompts Grid -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-[#1f222e]">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Curated AI Image Prompts</h2>
        <p class="text-xs text-slate-400 mt-1">Ready to copy and paste into Midjourney, Flux, Gemini, and ChatGPT</p>
      </div>
      <span class="font-mono text-xs px-2.5 py-1 rounded bg-[#161824] text-violet-300 border border-[#242738]">
        {prompts.length} Prompts
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {prompts.map((post) => (
        <a href={`/posts/${post.data.slug}`} class="group bg-[#131520] border border-[#23273a] hover:border-violet-500/60 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col shadow-lg">
          <div class="relative aspect-[3/4] overflow-hidden bg-black/40">
            <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#131520] via-transparent to-transparent opacity-80" />
            <div class="absolute top-3 left-3 px-2 py-0.5 rounded bg-black/60 backdrop-blur-md text-[11px] font-mono text-violet-300 border border-white/10">
              {post.data.model}
            </div>
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
            <div>
              <span class="text-[11px] text-violet-400 font-semibold">{post.data.category}</span>
              <h3 class="text-sm font-bold text-white group-hover:text-violet-300 transition-colors line-clamp-2 mt-0.5">
                {post.data.title}
              </h3>
            </div>
            <div class="pt-2 border-t border-[#1f222e] flex items-center justify-between text-xs text-slate-400">
              <span class="font-mono">{post.data.aspectRatio}</span>
              <span class="text-violet-400 font-semibold group-hover:underline">View Formula &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
