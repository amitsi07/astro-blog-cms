---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FilterBar from '../components/FilterBar.astro';
import PromptCard from '../components/PromptCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => data.status === 'published');
const prompts = allPosts.filter(p => p.data.type === 'prompt');
const categories = Array.from(new Set(prompts.map(p => p.data.category)));
---

<Layout title="PromptPlum AI – Curated AI Image Prompts & Astro CMS">
  <!-- Hero Section -->
  <Hero totalCount={prompts.length} />

  <!-- Category Filter Bar -->
  <FilterBar categories={categories} />

  <!-- Prompts Directory Grid -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-[#1f222e]">
      <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
        <span id="promptCountLabel" class="text-white font-bold text-sm">{prompts.length} Prompts Found</span>
        <span>·</span>
        <span class="text-emerald-400">1-Click Copy Ready</span>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="promptsGrid">
      {prompts.map((post) => (
        <PromptCard
          title={post.data.title}
          slug={post.data.slug}
          prompt={post.data.prompt}
          excerpt={post.data.excerpt}
          image={post.data.image}
          model={post.data.model}
          category={post.data.category}
          aspectRatio={post.data.aspectRatio}
        />
      ))}
    </div>

    <!-- Empty search fallback -->
    <div id="noResultsState" class="hidden text-center py-20 bg-[#12141f] rounded-2xl border border-[#23273a] my-8">
      <div class="w-12 h-12 rounded-full bg-violet-950/60 text-violet-400 flex items-center justify-center mx-auto mb-3 font-bold text-lg">✦</div>
      <h3 class="text-lg font-bold text-white mb-1">No prompts matched your search</h3>
      <p class="text-xs text-slate-400 mb-4">Try clearing filters or searching for terms like "Hasselblad", "rain", or "editorial".</p>
      <button id="resetFiltersBtn" class="px-4 py-2 rounded-xl bg-violet-600 hover:bg-violet-500 text-white text-xs font-semibold cursor-pointer">
        Reset All Filters
      </button>
    </div>
  </main>

  <!-- Homepage FAQ Accordion Section -->
  <section class="border-t border-[#1b1e2a] bg-[#0d0e14] py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-display font-extrabold text-white mb-2">Frequently Asked Questions</h2>
        <p class="text-xs sm:text-sm text-slate-400">Everything you need to know about our Astro static architecture & prompt formulas.</p>
      </div>

      <div class="space-y-4">
        <details class="group bg-[#131520] border border-[#23273a] rounded-xl p-4 [&_summary::-webkit-details-marker]:hidden" open>
          <summary class="flex items-center justify-between cursor-pointer text-sm font-bold text-white select-none">
            <span>Why is this site built with Astro instead of a traditional client-side SPA?</span>
            <span class="text-violet-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-300 leading-relaxed border-t border-[#1f222e] pt-3">
            Astro pre-renders all pages at build time into pure static HTML. This ensures instantaneous page loads, zero client-side JavaScript overhead for content reading, perfect Lighthouse 100 SEO scores, and free hosting on Cloudflare Pages global edge CDN.
          </p>
        </details>

        <details class="group bg-[#131520] border border-[#23273a] rounded-xl p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-bold text-white select-none">
            <span>How do I copy and use the AI prompts?</span>
            <span class="text-violet-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-300 leading-relaxed border-t border-[#1f222e] pt-3">
            Click the "Copy Prompt" button on any card or view the full post. The complete prompt with aspect ratios and engine flags is immediately copied to your clipboard, ready for Midjourney, Flux.1, or ChatGPT.
          </p>
        </details>

        <details class="group bg-[#131520] border border-[#23273a] rounded-xl p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-bold text-white select-none">
            <span>How does the CMS update content on Cloudflare Pages?</span>
            <span class="text-violet-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-300 leading-relaxed border-t border-[#1f222e] pt-3">
            Posts are stored as Markdown files in <code class="text-violet-300 bg-black/40 px-1 py-0.5 rounded">src/content/posts/</code>. You can manage them either through the built-in Sveltia / WP Admin CMS or push new Markdown files directly to GitHub, triggering an automatic Cloudflare Pages rebuild.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Interactive Client-side Search & Filter Script (Pure Vanilla JS, 0 dependencies!) -->
  <script is:inline>
    const searchInput = document.getElementById('promptSearchInput');
    const cards = document.querySelectorAll('.prompt-card');
    const countLabel = document.getElementById('promptCountLabel');
    const noResults = document.getElementById('noResultsState');
    const resetBtn = document.getElementById('resetFiltersBtn');

    let currentCategory = 'all';
    let currentModel = 'All';

    function filterCards() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const prompt = card.getAttribute('data-prompt') || '';
        const category = card.getAttribute('data-category') || '';
        const model = card.getAttribute('data-model') || '';

        const matchesQuery = !q || title.includes(q) || prompt.includes(q);
        const matchesCategory = currentCategory === 'all' || category.toLowerCase() === currentCategory.toLowerCase();
        const matchesModel = currentModel === 'All' || model === currentModel;

        if (matchesQuery && matchesCategory && matchesModel) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countLabel) countLabel.textContent = visibleCount + ' Prompts Found';
      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterCards);
    }

    // Category Buttons
    const catBtns = document.querySelectorAll('.cat-filter-btn');
    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => {
          b.classList.remove('bg-violet-600', 'text-white', 'shadow-sm');
          b.classList.add('bg-[#131520]', 'text-slate-400');
        });
        btn.classList.add('bg-violet-600', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-[#131520]', 'text-slate-400');
        currentCategory = btn.getAttribute('data-category') || 'all';
        filterCards();
      });
    });

    // Model Buttons
    const modelBtns = document.querySelectorAll('.model-filter-btn');
    modelBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        modelBtns.forEach(b => {
          b.classList.remove('bg-violet-600', 'text-white');
          b.classList.add('bg-[#151722]', 'text-slate-400');
        });
        btn.classList.add('bg-violet-600', 'text-white');
        btn.classList.remove('bg-[#151722]', 'text-slate-400');
        currentModel = btn.getAttribute('data-model') || 'All';
        filterCards();
      });
    });

    // Reset Filters
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentCategory = 'all';
        currentModel = 'All';

        catBtns.forEach((b, i) => {
          if (i === 0) {
            b.classList.add('bg-violet-600', 'text-white');
            b.classList.remove('bg-[#131520]', 'text-slate-400');
          } else {
            b.classList.remove('bg-violet-600', 'text-white');
            b.classList.add('bg-[#131520]', 'text-slate-400');
          }
        });

        modelBtns.forEach((b, i) => {
          if (i === 0) {
            b.classList.add('bg-violet-600', 'text-white');
            b.classList.remove('bg-[#151722]', 'text-slate-400');
          } else {
            b.classList.remove('bg-violet-600', 'text-white');
            b.classList.add('bg-[#151722]', 'text-slate-400');
          }
        });

        filterCards();
      });
    }

    // 1-Click Copy Prompt Button
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.copy-prompt-btn');
      if (btn) {
        e.preventDefault();
        const promptText = btn.getAttribute('data-prompt');
        if (promptText) {
          navigator.clipboard.writeText(promptText);
          const original = btn.textContent;
          btn.textContent = 'Copied! ✓';
          btn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('bg-emerald-600', 'text-white');
          }, 2000);
        }
      }
    });
  </script>
</Layout>
